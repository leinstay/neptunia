# systemd unit for the persona's scout errand agent (src/agent-runner/, profile scout).
#
# A separate, unprivileged process that runs internet errands for the bot
# through the subharness backend (`codex exec -s workspace-write --search` for
# codex; src/agent-runner/backend.ts). It reaches the internet but never the
# server's filesystem beyond its own out dir and the backend's folder in the
# private layer, and never localhost or private networks. The backend runs from
# <private>/subharness/<backend>/, which holds its binary and its login, so no
# model key reaches it beside its task.
#
# Codex sandboxes the commands it runs with its own bubblewrap. That works
# under this unit's NoNewPrivileges, ProtectSystem and PrivateTmp (checked
# with a transient unit of the same settings).
#
# `neptunia setup` renders this template for the installing user
# (deploy/README.md). The sandbox below is the mode `write`; `agent mode
# scout <mode>` in the chat renders the unit again: `full` drops the mount
# sandbox (ProtectSystem, ProtectHome and the bind and write paths) and `sudo`
# also drops NoNewPrivileges.
# Logs:    journalctl -u neptunia-agent-scout -f

[Unit]
Description=neptunia scout errand agent (Codex worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neptunia
Group=neptunia-discord-interface
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts errand-runner --profile scout
# Node's folder goes on the PATH; the backend is started by its path in the private layer.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# The bot's data directory, set as in the core unit (deploy/neptunia-core.service).
# The runner reads the override agents/scout/prompt.md from NEPTUNIA_DATA_DIR
# (the tracked agents/scout/prompt.md stays in the checkout; an override this
# user cannot read is skipped with one warning and the tracked prompt is used),
# and in a filtered scope withholds NEPTUNIA_DATA_DIR (src/agent-runner/policy.ts);
# it writes nothing under it. A deployment that keeps everything in the checkout
# deletes the line.
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
Restart=on-failure
RestartSec=5

# Writes only its state (out) dir, the runtime socket dir and the backend's
# folder <private>/subharness/<backend>/ (its sessions, logs and login), which
# `neptunia setup` binds after ProtectHome= while a backend is on; the rest of
# the home is an empty tmpfs, with ~/.local read-only; the persona folder is an
# empty tmpfs that shows only agents/ read-only and the backend's folder, both
# bound by `neptunia setup`, so her
# memory and keys are out of reach; everything else is read-only.
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/neptunia/.local
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
TemporaryFileSystem=/opt/neptunia/data:ro
StateDirectory=neptunia-agent-scout
RuntimeDirectory=neptunia-agent-scout
RuntimeDirectoryMode=0750

# Network: the agent reaches the public internet only. Localhost, link-local
# and private ranges are refused here as well as in code.
# The local resolver stub (systemd-resolved) is the one localhost address it may reach.
IPAddressAllow=127.0.0.53/32
IPAddressDeny=localhost
IPAddressDeny=link-local
IPAddressDeny=multicast
IPAddressDeny=127.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-agent-scout

[Install]
WantedBy=multi-user.target
