# systemd unit for the persona's scout errand agent (src/agent-runner/, profile scout).
#
# A separate, unprivileged process that runs internet errands for the bot
# through Codex (`codex exec -s workspace-write --search`, the profile's
# backend; src/agent-runner/backend.ts). It reaches the internet but never the
# server's filesystem beyond its own out dir and ~/.codex, and never localhost
# or private networks. It runs as the user `neptunia`, which holds the one
# Codex login of the server (~/.codex/auth.json), so no model key reaches it
# from the bot's .env.
#
# Codex sandboxes the commands it runs with its own bubblewrap. That works
# under this unit's NoNewPrivileges, ProtectSystem and PrivateTmp (checked
# with a transient unit of the same settings).
#
# The EnvironmentFile is optional and read only by the opencode backend
# (OPENROUTER_ERRAND_KEY=, OPENCODE_WEBSEARCH_KEY=, PROXY_URL=), when a task
# brings none.
#
# Install:
#   sudo install -d -o root -g root -m 0750 /opt/neptunia/etc
#   # optional overrides: sudo install -o root -g root -m 0600 /dev/null /opt/neptunia/etc/agent-scout.env
#   sudo cp deploy/neptunia-agent-scout.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now neptunia-agent-scout
# Logs:    journalctl -u neptunia-agent-scout -f
#
# The service group is the bot's (neptunia-discord-interface), which `neptunia`
# is a member of, so the runtime socket dir and the result files the agent
# writes are reachable by the core.

[Unit]
Description=neptunia scout errand agent (Codex worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neptunia
Group=neptunia-discord-interface
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts errand-runner --profile scout
# The runner starts `codex` by name: its folder and node's go on the PATH.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# The bot's directories (deploy/neptunia-bot.service), set as in its unit. The
# runner reads the override prompts.local/agent-scout.md from
# NEPTUNIA_PRIVATE_DIR (the tracked agents/scout/prompt.md stays in the
# checkout; an override this user cannot read is skipped with one warning and
# the tracked prompt is used), and in a filtered scope withholds NEPTUNIA_DATA_DIR
# and, when apart from the checkout, NEPTUNIA_PRIVATE_DIR
# (src/agent-runner/policy.ts); it writes under neither. A deployment that
# keeps everything in the checkout deletes both lines.
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/etc
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
# Optional overrides for the opencode backend (the leading '-': the file may be absent).
EnvironmentFile=-/opt/neptunia/etc/agent-scout.env
Restart=on-failure
RestartSec=5

# Writes only its state (out) dir, the runtime socket dir and ~/.codex (Codex's
# sessions, logs and login); the rest of the home is an empty tmpfs, with
# ~/.local (the codex binary) read-only; everything else is read-only or inaccessible.
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/neptunia/.codex
BindReadOnlyPaths=/home/neptunia/.local
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
InaccessiblePaths=/srv /opt/neptunia/data /opt/neptunia/etc/.env /var/www /etc/nginx /etc/letsencrypt /srv/neptunia-dev/.secrets
StateDirectory=neptunia-agent-scout
RuntimeDirectory=neptunia-agent-scout
RuntimeDirectoryMode=0750

# Network: the agent reaches the public internet only. Localhost, link-local
# and private ranges are refused here as well as in code.
# The local resolver stub (systemd-resolved) is the one localhost address it may reach.
IPAddressAllow=127.0.0.53/32
IPAddressDeny=localhost
IPAddressDeny=link-local
IPAddressDeny=multicast
IPAddressDeny=127.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-agent-scout

[Install]
WantedBy=multi-user.target
