# systemd unit for the persona's server-read errand agent (src/agent-runner/, profile server).
#
# A separate, unprivileged process that runs read-only errands on this server
# through OpenCode: it reads files and runs read-only shell commands to answer
# the owner's questions about the machine. Its network reaches only the local
# resolver and the model provider (IPAddressAllow; everything else denied),
# holds only the agents' OpenRouter key, and writes only its own out dir. It is
# granted CAP_DAC_READ_SEARCH so it can read any file like root WITHOUT being
# root -- the read-only guarantee is this unit (ProtectSystem=strict, no
# write paths), not a command filter. What it may DISCLOSE is cut by the
# engine per scope (src/agent-runner/policy.js), not by the OS here.
#
# Keys: every key lives in the bot's .env, which this process cannot read. The
# core sends the agents' key (OPENROUTER_AGENT_KEY) with each task. The
# EnvironmentFile is optional: an OPENROUTER_AGENT_KEY= there is used only when
# a task brings none.
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin neptunia-agent-server
#   sudo install -d -o root -g root -m 0750 /etc/neptunia
#   # optional override: sudo install -o root -g root -m 0600 /dev/null /etc/neptunia/agent-server.env
#   sudo cp deploy/neptunia-agent-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now neptunia-agent-server
# Logs:    journalctl -u neptunia-agent-server -f
#
# OpenCode's model price catalog fetch is disabled (the runner passes the model
# cost in the config, agents.<profile>.cost), so the only outbound traffic is
# the model API.

[Unit]
Description=neptunia server-read errand agent (OpenCode worker)
After=network.target

[Service]
Type=simple
User=neptunia-agent-server
Group=neptunia-discord-interface
WorkingDirectory=/opt/neptunia-bot
ExecStart=/opt/node/bin/node bin/agent-runner.mjs --profile server
# The bot's directories (deploy/neptunia-bot.service). Only NEPTUNIA_PRIVATE_DIR
# matters to the runner: it reads the override prompts.local/agent-server.md from
# it (the tracked prompts/agent-server.md stays in the checkout); the runner
# writes nothing under NEPTUNIA_DATA_DIR, which is set only to keep the units
# alike. A deployment that keeps everything in the checkout deletes both lines.
Environment=NEPTUNIA_PRIVATE_DIR=/etc/neptunia
Environment=NEPTUNIA_DATA_DIR=/var/lib/neptunia
# Optional override (the leading '-': the file may be absent); the key comes from the core.
EnvironmentFile=-/etc/neptunia/agent-server.env
Restart=on-failure
RestartSec=5

# Read everything like root, without being root.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

# Network only to the local resolver stub and to the model API (OpenRouter sits
# behind Cloudflare; these are Cloudflare's published IPv4 ranges). Everything
# else, the private ranges and the cloud metadata address included, is denied.
IPAddressDeny=any
IPAddressAllow=127.0.0.53/32
IPAddressAllow=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The whole system is read-only; the agent writes only its own state (out) dir
# and the runtime socket dir.
ProtectSystem=strict
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
StateDirectory=neptunia-agent-server
RuntimeDirectory=neptunia-agent-server
RuntimeDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-agent-server

[Install]
WantedBy=multi-user.target
