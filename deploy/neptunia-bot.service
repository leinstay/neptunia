# Example systemd unit for neptunia-bot.
#
# Install:   sudo cp deploy/neptunia-bot.service /etc/systemd/system/
#            sudo systemctl daemon-reload
# Enable:    sudo systemctl enable --now neptunia-bot
# Logs:      journalctl -u neptunia-bot -f
# Restart:   sudo systemctl restart neptunia-bot   (after `git pull` or an edit under src/)
# Stop:      sudo systemctl stop neptunia-bot
#
# Adjust WorkingDirectory/User to match your deployment before installing.
#
# Where the files live (the recommended layout): one root, the checkout holds
# the public code only and stays read-only to the service.
#   /opt/neptunia/
#     app/    the engine checkout (root-owned, read-only to the service)
#     etc/    .env, config.local/, prompts.local/       (NEPTUNIA_PRIVATE_DIR)
#     data/   everything the bot writes                 (NEPTUNIA_DATA_DIR)
# deploy/install.sh creates etc/ and data/ for the service user and installs
# this unit for the checkout (--dry-run shows its commands first).
#
# A deployment that keeps everything in the checkout (.env, config.local/,
# prompts.local/ and data/ next to the code) deletes the two Environment= lines
# below, points EnvironmentFile= at /opt/neptunia/app/.env and restores the old
# write paths:
#   ReadWritePaths=/opt/neptunia/app/data /opt/neptunia/app/prompts.local /opt/neptunia/app/config.local

[Unit]
Description=neptunia-bot — SillyTavern-inspired Discord pseudo-user engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neptunia/app
ExecStart=/usr/bin/node src/index.js
User=neptunia-bot
Restart=on-failure
RestartSec=5
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/etc
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
EnvironmentFile=-/opt/neptunia/etc/.env

# Hardening: the process needs write access only to its own data and
# per-deployment overrides (/config set writes config.local/config.json, /rules add
# writes prompts.local/rules.md); everything else, the checkout included,
# stays read-only.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/neptunia/data /opt/neptunia/etc
# strict leaves /tmp read-only too; the video fetcher cuts its clips under the
# temporary directory, so the service gets a private writable one.
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-bot

[Install]
WantedBy=multi-user.target
