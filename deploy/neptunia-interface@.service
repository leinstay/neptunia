# systemd template unit for one interface of the persona, as its own process:
# neptunia-interface@discord runs `neptunia interface run discord`
# (bin/neptunia.ts).
#
# The runner reads the client token <private>/clients/%i.token, connects to the
# core's socket <data>/run/core.sock and keeps the interface's data under
# <data>/interfaces/%i. The platform token comes from
# <data>/interfaces/%i/credentials.json, which the chat's `interfaces token set`
# writes. It reads config.local/config.json and config.local/interfaces/%i.json.
#
# `neptunia setup` renders this template for the installing user
# (deploy/README.md); `interfaces enable <name>` in the chat starts the unit.
# Logs:      journalctl -u neptunia-interface@discord -f

[Unit]
Description=neptunia interface %i
After=network-online.target neptunia-core.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts interface run %i
User=neptunia-%i-interface
Group=neptunia
# The runner opens the link again by itself. An interface that cannot (Discord)
# exits with code 1, and systemd starts it again.
Restart=always
RestartSec=5
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data

# Writes only its own data folder, and the core's files stay out of reach.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/neptunia/data/interfaces/%i
InaccessiblePaths=-/opt/neptunia/data/memory.db -/opt/neptunia/data/places
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-interface-%i

[Install]
WantedBy=multi-user.target
