# systemd unit for the watcher (src/watcher/, docs/watcher.md): one run, one report.
#
# `neptunia worker watcher` asks the watcher agent once, checks its answer, files the tasks it asks for on the board as the
# client `watcher` and writes `<watcher.dir>/reports/<UTC date>.md`. neptunia-watcher.timer starts it on `watcher.schedule`.
# A start that finds a report for the day does nothing. The unit is a oneshot, so the timer skips a day whose run is
# still going, and it never restarts itself after a failed run.
#
# The user is an agent user, never the core's: it reads the checkout, the private layer, the data folder and the logs,
# writes only the watcher folder and the board through the socket, and runs the agent backend from its folder in the
# private layer, where the backend's login is.
#
# `neptunia setup` renders this service and its timer for the installing user (deploy/README.md) and does not start
# them. The client token of the watcher is made once with scripts/client-token.ts (`add watcher --kind agent --roles
# watcher`), and `neptunia service watcher enable` enables the timer.
# Logs:    journalctl -u neptunia-watcher

[Unit]
Description=neptunia watcher (one report)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=neptunia
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts worker watcher
# The bot's directories (deploy/neptunia-bot.service), set as in its unit.
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/data
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
Environment=NEPTUNIA_TASK_CLIENT=watcher
# The agent backend is started by its path in the private layer; node's folder and the user's tools go on the PATH.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# A run takes what it takes.
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
