# systemd unit for the watcher (src/watcher/, docs/watcher.md): one run, one report.
#
# `neptunia worker watcher` claims one run, asks the watcher agent once, checks its answer, files the tasks it asks for on the
# board as the client `watcher` and commits one report per run under `data/agents/watcher/reports/`.
# neptunia-watcher.timer starts it on `watcher.schedule`, and `neptunia services watcher trigger` starts it at once. The unit
# is a oneshot, so a start during a run does nothing, and it never restarts itself after a failed run.
#
# The file system is read-only for this unit but for the watcher folder, which holds its reports and run records, and the
# backends' folders, which hold their sessions and logins. The checkout and the memory stay readable. What this does and does
# not enforce is in docs/watcher.md. It reaches the board through the core's socket and runs the agent backend from its
# folder in the private layer.
#
# `neptunia setup` renders this service and its timer for the installing user (deploy/README.md), makes the client
# `watcher` with its token and does not start them. `neptunia services watcher enable` enables the timer.
# Logs:    journalctl -u neptunia-watcher

[Unit]
Description=neptunia watcher (one report)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=neptunia
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts worker watcher
# The bot's directories (deploy/neptunia-bot.service), set as in its unit.
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/data
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
Environment=NEPTUNIA_TASK_CLIENT=watcher
# The agent backend is started by its path in the private layer; node's folder and the user's tools go on the PATH.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# The agent's own limit is WATCHER_RUN_TIMEOUT_MS (src/watcher/lifecycle.ts), 60 minutes. This leaves ten for filing and the
# commit, and ends a worker that hung past them.
TimeoutStartSec=70min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=-/opt/neptunia/data/agents/watcher -/opt/neptunia/data/subharness
