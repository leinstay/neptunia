# systemd unit for the persona's web errand agent (src/agent-runner/, profile web).
#
# A separate, unprivileged process that runs internet errands for the bot
# through OpenCode. It reaches the internet (through the residential proxy)
# but never the server's filesystem beyond its own out dir, never localhost or
# private networks, and holds only the agents' OpenRouter key -- never the
# persona's.
#
# Keys: every key lives in the bot's .env, which this process cannot read. The
# core sends them with each task (the agents' key OPENROUTER_AGENT_KEY, the
# proxy MEDIA_VIDEO_PROXY in its http form -- the residential proxy serves the
# video fetches and this agent alike -- and OPENCODE_WEBSEARCH_KEY when set).
# The EnvironmentFile is optional: what it sets (OPENROUTER_AGENT_KEY=,
# OPENCODE_WEBSEARCH_KEY=, PROXY_URL=) is used only when a task brings none.
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin neptunia-agent-web
#   sudo install -d -o root -g root -m 0750 /etc/neptunia
#   # optional overrides: sudo install -o root -g root -m 0600 /dev/null /etc/neptunia/agent-web.env
#   sudo cp deploy/neptunia-agent-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now neptunia-agent-web
# Logs:    journalctl -u neptunia-agent-web -f
#
# The service group is the bot's (neptunia-discord-interface) so the runtime
# socket dir and the result files the agent writes are reachable by the core.

[Unit]
Description=neptunia web errand agent (OpenCode worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neptunia-agent-web
Group=neptunia-discord-interface
WorkingDirectory=/opt/neptunia-bot
ExecStart=/opt/node/bin/node bin/agent-runner.mjs --profile web
# Optional overrides (the leading '-': the file may be absent); the keys come from the core.
EnvironmentFile=-/etc/neptunia/agent-web.env
Restart=on-failure
RestartSec=5

# Writes only its state (out) dir and the runtime socket dir; everything else
# is read-only or inaccessible.
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
InaccessiblePaths=/srv /opt/neptunia-bot/data /opt/neptunia-bot/.env /var/www /etc/nginx /etc/letsencrypt /srv/neptunia-dev/.secrets
StateDirectory=neptunia-agent-web
RuntimeDirectory=neptunia-agent-web
RuntimeDirectoryMode=0750

# Network: the agent reaches the public internet only. Localhost, link-local
# and private ranges are refused here as well as in code.
# The local resolver stub (systemd-resolved) is the one localhost address it may reach.
IPAddressAllow=127.0.0.53/32
IPAddressDeny=localhost
IPAddressDeny=link-local
IPAddressDeny=multicast
IPAddressDeny=127.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-agent-web

[Install]
WantedBy=multi-user.target
