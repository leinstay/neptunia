# systemd timer for neptunia-selfimprovement.service, one beat every six hours UTC. The service is a oneshot, so a
# beat still running at the next scheduled time is not started twice. A beat missed while the machine is off is skipped.

[Unit]
Description=neptunia selfimprovement, every six hours UTC

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
Unit=neptunia-selfimprovement.service

[Install]
WantedBy=timers.target
