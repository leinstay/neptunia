# systemd unit for the persona's core, with the interfaces as units.
#
# The core runs src/index.ts with no interface of its own: it listens on
# <data>/run/core.sock and each interface connects from its own unit
# (deploy/neptunia-interface@.service). It refuses to start while another core
# holds the memory database or renewed core:alive within its ttl.
#
# `neptunia setup` renders this template for the installing user and starts it
# (deploy/README.md). The paths below are the template's own and are replaced
# by the folders of the installation.
# Logs:      journalctl -u neptunia-core -f   (journalctl --user-unit for a user unit)

[Unit]
Description=neptunia core (interfaces as units)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node src/index.ts
User=neptunia-bot
Group=neptunia
Restart=on-failure
RestartSec=5
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
# The subharness backend runs from its folder in the private directory; node's
# folder and the user's own tools go on the PATH.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin

# The journal readers' group, so the watcher the core starts reads the other units' journal. A user unit cannot set
# groups and does not carry this line.
SupplementaryGroups=systemd-journal
# The hardening: writes go to the data and the
# private directory only, which holds the subharness backend's folder.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/neptunia/data
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-core

[Install]
WantedBy=multi-user.target
