# systemd unit for one beat of her self-development (src/selfdev/, docs/selfdev.md): `neptunia selfdev run` takes her
# fix proposals off the board, works each in a worktree under <data>/selfdev/, runs the tests and opens the pull request.
#
# The beat works on a dev checkout, never on the deployed one: `neptunia setup` renders this unit and its timer only
# when `selfdev.checkout` names another checkout, and the WorkingDirectory below becomes that path. The private and
# data folders stay the deployment's, so the beat reaches the core's board through its socket as the client `selfdev`
# (token `<private>/clients/selfdev.token`, made once with scripts/client-token.ts).
#
# `neptunia setup` renders this service and neptunia-selfdev.timer for the installing user (deploy/README.md) and does
# not start them: `systemctl enable --now neptunia-selfdev.timer` (`--user` for a user unit).
# Run now: systemctl start neptunia-selfdev.service
# Logs:    journalctl -u neptunia-selfdev

[Unit]
Description=neptunia selfdev (one beat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=neptunia
WorkingDirectory=/opt/neptunia/app
ExecStart=/opt/node/bin/node bin/neptunia.ts selfdev run
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/etc
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
# git, gh and the agent backend's binary are found by name: the user's own tools and node's folder go on the PATH.
Environment=PATH=/home/neptunia/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
# A dev run may take an hour (bin/selfdev.ts), and the tests after it take their time.
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
