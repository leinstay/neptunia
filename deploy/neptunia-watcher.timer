# systemd timer for neptunia-watcher.service. `neptunia setup` and `neptunia service watcher setup` replace the
# calendar line with one line per slot of `watcher.schedule`, UTC, the server clock, or with an interval. After a downtime
# `Persistent=true` starts one run however many slots passed. The worker writes one report per UTC day and a day that has
# one is skipped.

[Unit]
Description=neptunia watcher, on its schedule

[Timer]
OnCalendar=*-*-* 00:00:00 UTC
Persistent=true
Unit=neptunia-watcher.service

[Install]
WantedBy=timers.target
