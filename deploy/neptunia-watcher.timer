# systemd timer for neptunia-watcher.service. `neptunia setup` and `neptunia services watcher setup` replace the
# calendar line with one line per slot of `watcher.schedule`, UTC, the server clock, or with an interval. After a downtime
# `Persistent=true` starts one run however many slots passed. Every run keeps its own report, and a start during a run
# starts nothing.

[Unit]
Description=neptunia watcher, on its schedule

[Timer]
OnCalendar=*-*-* 00:00:00 UTC
Persistent=true
Unit=neptunia-watcher.service

[Install]
WantedBy=timers.target
