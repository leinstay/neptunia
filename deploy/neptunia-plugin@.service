# systemd template unit for one plugin of the persona, as its own process:
# neptunia-plugin@echo runs `neptunia plugin run echo` (bin/neptunia.ts) as the
# user neptunia-plugin-echo.
#
# `/plugins enable <name>` writes the plugin's client token <private>/clients/%i.token
# (mode 0600, owned by the core's user) and starts this unit. systemd reads the token
# as root and hands it over as the credential "token" (LoadCredential), so the plugin's
# own user needs no access to the private folder's clients/. The runner connects to the
# core's socket <data>/run/core.sock as a member of the group neptunia and keeps the
# plugin's state under <data>/plugins/%i. It reads no .env: the keys the plugin's
# plugin.json lists come from the optional environment file below.
# plugins/README.md says how to write and connect a plugin, deploy/README.md has the units.
#
# Install:   sudo deploy/install.sh   (installs this unit, does not enable it)
# Start:     /plugins enable echo     (or: sudo systemctl start neptunia-plugin@echo)
# Logs:      journalctl -u neptunia-plugin@echo -f

[Unit]
Description=neptunia plugin %i
After=network-online.target neptunia-core.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neptunia/app
ExecStart=/usr/bin/node bin/neptunia.ts plugin run %i
User=neptunia-plugin-%i
Group=neptunia
# The runner opens the link again by itself, and the core refuses a plugin that is
# off: systemd starts the runner again after a crash only.
Restart=on-failure
RestartSec=5
Environment=NEPTUNIA_PRIVATE_DIR=/opt/neptunia/etc
Environment=NEPTUNIA_DATA_DIR=/opt/neptunia/data
EnvironmentFile=-/opt/neptunia/etc/clients/%i.env
LoadCredential=token:/opt/neptunia/etc/clients/%i.token

# Writes only its own data folder, and the core's files stay out of reach.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/neptunia/data/plugins/%i
InaccessiblePaths=-/opt/neptunia/etc/.env -/opt/neptunia/data/memory.db -/opt/neptunia/data/guilds
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptunia-plugin-%i

[Install]
WantedBy=multi-user.target
