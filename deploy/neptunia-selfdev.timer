# systemd timer for neptunia-selfdev.service: one beat every hour, the server clock. The service is a oneshot, so a
# beat still running when the hour comes is not started twice; a beat missed while the machine was off is not caught up.

[Unit]
Description=neptunia selfdev, hourly

[Timer]
OnCalendar=hourly
Unit=neptunia-selfdev.service

[Install]
WantedBy=timers.target
