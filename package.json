{
  "name": "neptunia",
  "version": "0.1.0",
  "description": "Discord pseudo-user engine: one LLM-driven persona per server, personality supplied through prompt files",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leinstay/neptunia.git"
  },
  "homepage": "https://github.com/leinstay/neptunia#readme",
  "bugs": {
    "url": "https://github.com/leinstay/neptunia/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "llm",
    "openrouter",
    "persona",
    "chatbot"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "check:codes": "node tools/labels-catalogue.mjs --check",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "typecheck": "node tools/type-baseline.mjs",
    "typecheck:update": "node tools/type-baseline.mjs --update",
    "format:check": "prettier --check",
    "health": "node tools/code-health.mjs && node tools/code-health.mjs --check-docs",
    "health:update": "node tools/code-health.mjs --update"
  },
  "workspaces": [
    "interfaces/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
