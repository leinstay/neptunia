{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "interfaces", "tests", "scripts", "bin", "agents"],
  "exclude": ["node_modules", "**/node_modules", ".agents", "data", "references", "prompts.local", "scripts/fixtures"]
}
