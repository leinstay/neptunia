# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Loaded by src/config.js, a plain KEY=VALUE parser (quotes and # comments
# supported), not the "dotenv" package. Values already present in the real
# process environment are never overridden by this file. Secrets are read once
# at startup; everything else lives in config.json and is hot-reloaded.
# This file is read from the checkout, or from NEPTUNIA_PRIVATE_DIR when that is
# set in the process environment (see docs/configuration.md; NEPTUNIA_DATA_DIR moves data/).

# Discord bot token (Developer Portal → Bot → Token). The bot needs the
# "Message Content" privileged intent enabled on the same page.
DISCORD_TOKEN=

# API key for the chat-completions endpoint configured as llm.baseUrl in
# config.json (OpenRouter by default; get a key at https://openrouter.ai/keys).
# Any OpenRouter-compatible endpoint works, e.g. a self-hosted gateway or
# another provider's compatible API.
OPENROUTER_API_KEY=

# Optional. A second OpenRouter key used ONLY by the simulation and maintenance
# tools under tools/ (replay, import-turns, memory-sim, backfill, warmup,
# embed-index). Without it the tools fall back to OPENROUTER_API_KEY and print
# a warning that they are spending the bot's live key. When set, the owner's
# status card shows its limit; the bot never sends a model request with it.
OPENROUTER_SIM_KEY=

# Optional. An OpenRouter management key. When set, the owner's status card
# reads each key's activity with it (one read-only GET per key) and shows the
# last 7 and 30 days from OpenRouter's own figures. WARNING: a management key
# can create, change and delete every key of the account; the bot only reads
# activity with it and never logs it.
OPENROUTER_MANAGEMENT_KEY=

# Optional. The errand agents' own OpenRouter key (llm.keyByRole maps the roles
# web and server to it), never this bot's. The core sends it to the
# agent runners with each task (they cannot read this file). The owner's status
# card shows its limit and spend as the "agents" key; the bot never sends a model
# request of its own with it. Unset: no "agents" line, with one log line.
OPENROUTER_AGENT_KEY=

# Optional. The coding worker's own OpenRouter key (llm.keyByRole maps the role
# dev to it). The status card shows it as the "development" key; the bot
# never sends a model request with it. Unset: no "development" line, with one
# log line.
OPENROUTER_DEV_KEY=

# Optional. The web errand agent's search key (agents.web.search, provider
# parallel) and the residential proxy (socks5h:// or http://, one port serving
# both) it goes through -- the same proxy as the video fetches when
# media.video.proxy is "${env:MEDIA_VIDEO_PROXY}". Like every key they live
# here: the core sends them to the web agent with each task (a socks5h:// URL in
# its http form), since the runners cannot read this file.
OPENCODE_WEBSEARCH_KEY=
MEDIA_VIDEO_PROXY=

# Optional. YouTube Data API key for learning video duration when yt-dlp is
# unavailable (Google Cloud console → YouTube Data API v3, free tier).
YOUTUBE_API_KEY=

# Optional. Brave Search API key for the web lookup (features.webLookup): lets
# the persona search the web when asked something it cannot know. Without it
# only links in the chat are read (https://brave.com/search/api/).
BRAVE_SEARCH_API_KEY=

# Optional. Exa API key for the `exa` search engine (web.search.engine): Exa
# answers without a key on its free tier; with one it is sent as a bearer token.
EXA_API_KEY=
