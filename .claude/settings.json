{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/rule-files-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking whether this is a rule file"
          }
        ]
      }
    ]
  }
}
